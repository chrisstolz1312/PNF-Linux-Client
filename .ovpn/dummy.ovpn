client
dev tun1312
proto udp
remote 192.168.0.0 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
tun-mtu 1280
mssfix 1200
keepalive 5 20
cipher CHACHA20-POLY1305
verb 3

<ca>
-----BEGIN CERTIFICATE-----

-----END CERTIFICATE-----
</ca>

<cert>
-----BEGIN CERTIFICATE-----

-----END CERTIFICATE-----
</cert>

<key>
-----BEGIN PRIVATE KEY-----

-----END PRIVATE KEY-----
</key>

<tls-crypt>
#
# 2048 bit OpenVPN static key
#
-----BEGIN OpenVPN Static key V1-----

</tls-crypt>
